/*
 * Build the combined club list once config.js loads.
 */
window.GAME_CONFIG.clubs =
  window.GAME_CONFIG.premierLeagueClubs.concat(
    window.GAME_CONFIG.laLigaClubs
  );

/*
 * Safety check.
 */
if (
  !window.GAME_CONFIG ||
  !Array.isArray(window.GAME_CONFIG.clubs)
) {
  console.error("Super League Soccer: configuration failed to load.");
} else {
  console.info(
    "Super League Soccer config loaded successfully."
  );
}
